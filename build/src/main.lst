  28:src/main.cpp  **** void pokreni_testove_alokacije() {
  29:src/main.cpp  ****     // =============================================================
  30:src/main.cpp  ****     // TEST 1: Osnovni 'new' i 'delete' za primitivne tipove
  31:src/main.cpp  ****     // =============================================================
  32:src/main.cpp  ****     int* p1 = new int(123);
  33:src/main.cpp  **** 
  34:src/main.cpp  ****     if (p1 == nullptr) {
  35:src/main.cpp  ****         printString("TEST 1 PAO: Alokator je vratio nullptr!\n");
  36:src/main.cpp  ****         return;
  37:src/main.cpp  ****     }
  38:src/main.cpp  **** 
  39:src/main.cpp  ****     if (*p1 != 123) {
  40:src/main.cpp  ****         printString("TEST 1 PAO: Vrednost u memoriji nije ispravno upisana!\n");
  41:src/main.cpp  ****         delete p1;
  42:src/main.cpp  ****         return;
  43:src/main.cpp  ****     }
  44:src/main.cpp  **** 
  45:src/main.cpp  ****     delete p1;  //Ovde proveravaš tvoj free/delete
  46:src/main.cpp  ****     printString("TEST 1 PROŠAO: Osnovni new/delete radi.\n");
  47:src/main.cpp  **** 
  48:src/main.cpp  **** 
  49:src/main.cpp  ****     // =============================================================
  50:src/main.cpp  ****     // TEST 2: Alokacija objekta (Provera poziva konstruktora)
  51:src/main.cpp  ****     // =============================================================
  52:src/main.cpp  ****     TestObjekat* mojObj = new TestObjekat(777);
  53:src/main.cpp  **** 
  54:src/main.cpp  ****     if (mojObj == nullptr) {
  55:src/main.cpp  ****         printString("TEST 2 PAO: Neuspešna alokacija strukture/objekta!\n");
  56:src/main.cpp  ****         return;
  57:src/main.cpp  ****     }
  58:src/main.cpp  **** 
  59:src/main.cpp  ****     // Provera da li su polja ispravno inicijalizovana kroz konstruktor
  60:src/main.cpp  ****     if (mojObj->id != 777 || mojObj->vrednosti[2] != 0xBEEF) {
  61:src/main.cpp  ****         printString("TEST 2 PAO: Konstruktor nije pozvan ili su podaci korumpirani!\n");
  62:src/main.cpp  ****         delete mojObj;
  63:src/main.cpp  ****         return;
  64:src/main.cpp  ****     }
  65:src/main.cpp  **** 
  66:src/main.cpp  ****     delete mojObj;
  67:src/main.cpp  ****     printString("TEST 2 PROŠAO: Konstruktor se uspešno izvršava preko 'new'.\n");
  68:src/main.cpp  **** 
  69:src/main.cpp  **** 
  70:src/main.cpp  ****     // =============================================================
  71:src/main.cpp  ****     // TEST 3: Alokacija niza objekata (new[] i delete[])
  72:src/main.cpp  ****     // =============================================================
  73:src/main.cpp  ****     const int velicina_niza = 10;
  74:src/main.cpp  ****     int* niz = new int[velicina_niza];
  75:src/main.cpp  **** 
  76:src/main.cpp  ****     if (niz == nullptr) {
  77:src/main.cpp  ****         printString("TEST 3 PAO: 'new[]' je vratio nullptr za niz!\n");
  78:src/main.cpp  ****         return;
  79:src/main.cpp  ****     }
GAS LISTING /tmp/ccggYc3n.s 			page 3


  80:src/main.cpp  **** 
  81:src/main.cpp  ****     // Upisujemo podatke kroz ceo opseg niza (provera granica i alignment-a)
  82:src/main.cpp  ****     for (int i = 0; i < velicina_niza; i++) {
  83:src/main.cpp  ****         niz[i] = i * 10;
  84:src/main.cpp  ****     }
  85:src/main.cpp  **** 
  86:src/main.cpp  ****     // Provera ispravnosti upisanog
  87:src/main.cpp  ****     bool niz_validan = true;
  88:src/main.cpp  ****     for (int i = 0; i < velicina_niza; i++) {
  89:src/main.cpp  ****         if (niz[i] != i * 10) {
  90:src/main.cpp  ****             niz_validan = false;
  91:src/main.cpp  ****             break;
  92:src/main.cpp  ****         }
  93:src/main.cpp  ****     }
  94:src/main.cpp  **** 
  95:src/main.cpp  ****     delete[] niz; // Jako bitno da koristiš delete[] sa zagradama!
  96:src/main.cpp  **** 
  97:src/main.cpp  ****     if (!niz_validan) {
  98:src/main.cpp  ****         printString("TEST 3 PAO: Podaci u nizu su pregaženi ili korumpirani!\n");
  99:src/main.cpp  ****         return;
 100:src/main.cpp  ****     }
 101:src/main.cpp  ****     printString("TEST 3 PROŠAO: Alokacija i dealokacija nizova radi.\n");
 102:src/main.cpp  **** 
 103:src/main.cpp  ****     printString("--- SVI NEW/DELETE TESTOVI USPEŠNO ZAVRŠENI! ---\n");
 104:src/main.cpp  **** }
