 148:src/main.cpp  **** 
 149:src/main.cpp  ****     // 1. Kreiranje prve niti
 150:src/main.cpp  ****     int res1 = thread_create(&nit1, kod_za_nit_jedan, nullptr);
 151:src/main.cpp  **** 
